{
  "name": "knownmap-v1",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "description": "KnownMap v1 workspace - web, extension and shared contracts",
  "engines": {
    "node": ">=18.0.0"
  },
  "workspaces": [
    "web",
    "web/shared",
    "web/admin",
    "web/teacher",
    "extension",
    "contracts"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:admin": "npm run dev --workspace @v1/web-admin",
    "dev:teacher": "npm run dev --workspace @v1/web-teacher",
    "build": "npm run build --workspace @v1/web-admin && npm run build --workspace @v1/web-teacher",
    "lint": "eslint web extension contracts",
    "type-check": "tsc --noEmit",
    "gate": "vite-node tools/release-gate-check.mts"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "esbuild": "0.28.2",
    "eslint": "^8.54.0",
    "typescript": "^5.3.0",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "ajv": "8.17.1"
  }
}
