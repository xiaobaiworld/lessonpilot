{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://knownmap.local/schema/v2/course-package.schema.json",
  "title": "KnownMap Course Package v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "courseId",
    "releaseId",
    "releaseNumber",
    "title",
    "lessons",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "courseId": { "type": "string", "format": "uuid" },
    "releaseId": { "type": "string", "format": "uuid" },
    "releaseNumber": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 255 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "lessons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lessonId", "title", "videoRef", "nodes"],
        "properties": {
          "lessonId": { "type": "string", "format": "uuid" },
          "title": { "type": "string", "minLength": 1, "maxLength": 255 },
          "videoRef": {
            "type": "object",
            "additionalProperties": false,
            "required": ["platform", "videoId"],
            "properties": {
              "platform": { "const": "bilibili" },
              "videoId": { "type": "string", "pattern": "^BV[0-9A-Za-z]{10}$" }
            }
          },
          "nodes": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/definitions/node" }
          }
        }
      }
    }
  },
  "definitions": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "enabled",
        "family",
        "interaction",
        "trigger",
        "display",
        "evaluation",
        "effects"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "enabled": { "const": true },
        "family": { "enum": ["attention", "practice"] },
        "interaction": { "enum": ["notice", "choice", "blank", "free_text"] },
        "trigger": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "timeSeconds"],
          "properties": {
            "kind": { "const": "time_cross" },
            "timeSeconds": { "type": "number", "minimum": 0 },
            "captionId": { "type": ["string", "null"] }
          }
        },
        "display": { "type": "object" },
        "evaluation": { "type": ["object", "null"] },
        "effects": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pause"],
          "properties": { "pause": { "const": true } }
        }
      }
    }
  }
}
