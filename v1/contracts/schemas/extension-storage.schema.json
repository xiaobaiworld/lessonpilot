{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://knownmap.local/schema/v2/extension-storage.schema.json",
  "title": "KnownMap Extension Storage Schema v2.2.0",
  "description": "The chrome.storage.local root used by the student extension.",
  "type": "object",
  "additionalProperties": false,
  "required": ["storage_schema_version", "localIdentity", "installedCourses", "authorizationSourceCache", "localLearningState", "quarantine"],
  "properties": {
    "storage_schema_version": { "type": "string", "pattern": "^2\\.\\d+\\.\\d+$" },
    "localIdentity": { "anyOf": [{ "$ref": "#/definitions/localIdentity" }, { "type": "null" }] },
    "installedCourses": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/installedCourse" }
    },
    "authorizationSourceCache": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources"],
      "properties": { "sources": { "type": "array", "items": { "$ref": "#/definitions/authorizationSource" } } }
    },
    "localLearningState": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": { "$ref": "#/definitions/lessonProgress" }
      }
    },
    "quarantine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entries"],
      "properties": { "entries": { "type": "array", "items": { "$ref": "#/definitions/quarantineEntry" } } }
    },
    "settings": {
      "$ref": "#/definitions/studentSettings"
    },
    "upgradeQueue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tasks"],
      "properties": {
        "tasks": {
          "type": "array",
          "items": { "$ref": "#/definitions/upgradeTask" }
        }
      }
    }
  },
  "definitions": {
    "localIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clientId", "proof", "proofSalt", "createdAt"],
      "properties": {
        "clientId": { "type": "string", "format": "uuid" },
        "proof": { "type": "string", "minLength": 1 },
        "proofSalt": { "type": "string", "minLength": 1 },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetId", "kind", "mimeType", "byteSize", "sha256", "sourceType"],
      "properties": {
        "assetId": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["image", "audio", "video"] },
        "mimeType": { "type": "string", "minLength": 1 },
        "byteSize": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "alt": { "type": "string" },
        "sourceType": { "enum": ["uploaded", "licensed"] }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "enabled", "family", "interaction", "anchor", "title", "content", "interactionData", "effects"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "enabled": { "const": true },
        "family": { "enum": ["attention", "practice"] },
        "interaction": { "enum": ["notice", "choice", "blank", "free_text"] },
        "anchor": { "type": "object", "additionalProperties": false, "required": ["kind", "timeSeconds"], "properties": { "kind": { "const": "time_cross" }, "timeSeconds": { "type": "number", "minimum": 0 }, "captionId": { "type": ["string", "null"] } } },
        "title": { "type": "string", "minLength": 1 },
        "content": { "$ref": "#/definitions/document" },
        "interactionData": { "type": ["object", "null"] },
        "presentationHints": { "type": "object", "additionalProperties": false, "properties": { "windowSize": { "enum": ["s", "m", "l", "overlay"] }, "windowStyle": { "enum": ["card", "document"] }, "windowPosition": { "enum": ["bottom-left", "bottom-right", "center"] } } },
        "effects": { "type": "object", "additionalProperties": false, "required": ["pause"], "properties": { "pause": { "const": true } } }
      }
    },
    "inline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "marks": { "type": "array", "items": { "enum": ["strong", "em", "underline"] } },
        "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{3,8}$" },
        "link": { "type": "object", "additionalProperties": false, "required": ["href"], "properties": { "href": { "type": "string", "minLength": 1 } } }
      }
    },
    "inlineBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "children"],
      "properties": {
        "type": { "enum": ["paragraph", "quote"] },
        "children": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/inline" } }
      }
    },
    "heading": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "level", "children"],
      "properties": {
        "type": { "const": "heading" },
        "level": { "enum": [2, 3] },
        "children": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/inline" } }
      }
    },
    "list": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "ordered", "items"],
      "properties": {
        "type": { "const": "list" },
        "ordered": { "type": "boolean" },
        "items": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["children"], "properties": { "children": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/inline" } } } } }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "assetId", "alt"],
      "properties": { "type": { "const": "image" }, "assetId": { "type": "string", "minLength": 1 }, "alt": { "type": "string" } }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "assetId"],
      "properties": { "type": { "const": "audio" }, "assetId": { "type": "string", "minLength": 1 }, "title": { "type": "string" } }
    },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "assetId"],
      "properties": { "type": { "const": "video" }, "assetId": { "type": "string", "minLength": 1 }, "title": { "type": "string" }, "posterAssetId": { "type": "string", "minLength": 1 } }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "blocks"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "blocks": { "type": "array", "minItems": 1, "items": { "anyOf": [{ "$ref": "#/definitions/inlineBlock" }, { "$ref": "#/definitions/heading" }, { "$ref": "#/definitions/list" }, { "$ref": "#/definitions/image" }, { "$ref": "#/definitions/audio" }, { "$ref": "#/definitions/video" }] } }
      }
    },
    "installedLesson": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lessonId", "title", "videoId", "page", "nodes"],
      "properties": {
        "lessonId": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "videoId": { "type": "string", "pattern": "^BV[0-9A-Za-z]{10}$" },
        "page": { "type": "integer", "minimum": 1 },
        "cid": { "anyOf": [{ "type": "string", "pattern": "^[0-9]+$" }, { "type": "null" }] },
        "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/node" } }
      }
    },
    "installedCourse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["courseId", "title", "lessons", "assets", "publishedAt", "installedAt", "source", "readOnly", "sourceId"],
      "properties": {
        "courseId": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "lessons": { "type": "array", "items": { "$ref": "#/definitions/installedLesson" } },
        "assets": { "type": "array", "items": { "$ref": "#/definitions/asset" } },
        "releaseId": { "type": "string", "format": "uuid" },
        "releaseNumber": { "type": "integer", "minimum": 1 },
        "publishedAt": { "type": "string", "format": "date-time" },
        "installedAt": { "type": "string", "format": "date-time" },
        "source": { "enum": ["example", "authorized"] },
        "readOnly": { "type": "boolean" },
        "sourceId": { "type": "string", "minLength": 1 }
      }
    },
    "authorizationSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "codeHint", "redeemedAt", "courseIds", "expiresAt"],
      "properties": {
        "sourceId": { "type": "string", "minLength": 1 },
        "codeHint": { "type": "string", "minLength": 1, "maxLength": 5 },
        "redeemedAt": { "type": "string", "format": "date-time" },
        "courseIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "expiresAt": { "anyOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] }
      }
    },
    "nodeAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "answer", "correct"],
      "properties": { "at": { "type": "string", "format": "date-time" }, "answer": { "type": "string" }, "correct": { "type": ["boolean", "null"] } }
    },
    "lessonProgress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["done", "attempts", "lastPositionSeconds", "updatedAt"],
      "properties": {
        "done": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "attempts": { "type": "object", "additionalProperties": { "type": "array", "items": { "$ref": "#/definitions/nodeAttempt" } } },
        "lastPositionSeconds": { "type": "number", "minimum": 0 },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "quarantineEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "reason", "sample"],
      "properties": { "at": { "type": "string", "format": "date-time" }, "reason": { "type": "string", "minLength": 1 }, "sample": { "type": "string", "maxLength": 200 } }
    },
    "studentSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["showRedeemEntry", "showRecommendations", "syncMode", "shortcut", "mascot"],
      "properties": {
        "showRedeemEntry": { "type": "boolean" },
        "showRecommendations": { "type": "boolean" },
        "syncMode": { "enum": ["auto", "prompt", "manual"] },
        "shortcut": { "enum": ["Alt+K"] },
        "mascot": { "enum": ["standard"] }
      }
    },
    "upgradeTask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskKey",
        "courseId",
        "previousReleaseId",
        "targetReleaseId",
        "targetReleaseNumber",
        "createdAt",
        "updatedAt",
        "status",
        "currentAssetId",
        "completedAssetHashes",
        "retryCount",
        "lastError"
      ],
      "properties": {
        "taskKey": { "type": "string", "minLength": 1 },
        "courseId": { "type": "string", "minLength": 1 },
        "previousReleaseId": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "targetReleaseId": { "type": "string", "minLength": 1 },
        "targetReleaseNumber": { "type": "integer", "minimum": 1 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "status": {
          "enum": [
            "queued",
            "downloading",
            "verifying",
            "ready_to_commit",
            "committed",
            "paused",
            "failed",
            "cancelled"
          ]
        },
        "currentAssetId": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
        "completedAssetHashes": {
          "type": "object",
          "additionalProperties": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
        },
        "retryCount": { "type": "integer", "minimum": 0 },
        "lastError": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
      }
    }
  }
}
