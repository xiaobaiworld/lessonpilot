output/playwright/

# Pages publish assembly output (D-010).
# The shared contract has exactly one source of truth in src/shared/.
# teacher-web/shared/ is assembled at publish time and must never be committed,
# or the repository would carry a second, silently drifting copy of the contract.
teacher-web/shared/

# Pages 发布产物，由 workflow 现场组装，不入库
site/
