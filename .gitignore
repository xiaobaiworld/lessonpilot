# Dependencies
node_modules/
backend/.venv/
backend/.pytest_cache/
backend/.coverage
backend/**/__pycache__/
*.py[cod]

# Build output
dist/
build/

# Local config and secrets
.env
.env.*
!.env.example
config.local.*
*.key
*.pem

# Logs
logs/
*.log
backend/*.db
# 备份与 SQLite 副本文件：`*.db` 匹配不到 knownmap.db.bak-<时间戳> 这种名字，
# 而它确实被提交过一次（8f37caf，用 `git add backend` 带进来的）。
backend/*.db.bak*
backend/*.db-*
backend/*.sqlite*

# macOS
.DS_Store

# Agent tool state (not project content)
.superpowers/
.gstack/
.playwright-cli/
output/playwright/

# Pages publish assembly output (D-010).
# The shared contract has exactly one source of truth in src/shared/.
# teacher-web/shared/ is assembled at publish time and must never be committed,
# or the repository would carry a second, silently drifting copy of the contract.
teacher-web/shared/

# Pages 发布产物，由 workflow 现场组装，不入库
site/
