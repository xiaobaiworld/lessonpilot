{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knownmap.com/contracts/course-package.v1.schema.json",
  "title": "KnownMap 课程发布包 v1",
  "description": "CourseRelease 按授权范围形成的只读投影。真源见 doc/design/v1/06-interface-contracts.md 第 5 节；领域约束见 04 第 8 节。禁止字段见 06 第 5.2 节，由 propertyNames 与 additionalProperties: false 共同保证。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageType",
    "courseId",
    "releaseId",
    "releaseNumber",
    "title",
    "packageDigest",
    "authorizedScope",
    "lessons"
  ],
  "properties": {
    "schemaVersion": {
      "description": "主版本。未知值必须安全拒绝，不得降级解析。",
      "const": 1
    },
    "packageType": {
      "description": "包类型判别字段。将来新增包类型时用它区分，不靠字段猜测。",
      "const": "course-release"
    },
    "courseId": {
      "$ref": "#/$defs/stableId"
    },
    "releaseId": {
      "$ref": "#/$defs/stableId"
    },
    "releaseNumber": {
      "description": "课程内发布序号，从 1 单调递增。04 第 8 节要求 (course_id, release_number) 唯一。",
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "$ref": "#/$defs/shortText"
    },
    "packageDigest": {
      "$ref": "#/$defs/sha256Digest"
    },
    "authorizedScope": {
      "$ref": "#/$defs/authorizedScope"
    },
    "lessons": {
      "description": "按 order 升序的课节实例。内容相同的课节也是不同实例，不去重（D-V1-010）。",
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/lesson"
      }
    }
  },
  "$defs": {
    "stableId": {
      "description": "后端生成的不可猜测稳定标识。可打印 ASCII，不含首尾空白。",
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[\\x21-\\x7E]+$"
    },
    "shortText": {
      "description": "教师可见短文本。非空白，长度有上限以防超大载荷。",
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    },
    "longText": {
      "description": "教师编写的正文或反馈。",
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "pattern": "\\S"
    },
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "authorizedScope": {
      "description": "本包对应的有效授权范围。type 决定哪些数组有意义：course 时两个数组必须为空；lesson 时只有 lessonIds 非空；node 时两者都非空。约束由 allOf 表达，不靠调用方记得。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "lessonIds",
        "nodeIds"
      ],
      "properties": {
        "type": {
          "enum": [
            "course",
            "lesson",
            "node"
          ]
        },
        "lessonIds": {
          "type": "array",
          "maxItems": 500,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        },
        "nodeIds": {
          "type": "array",
          "maxItems": 5000,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "course"
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "lessonIds": {
                "maxItems": 0,
                "type": "array"
              },
              "nodeIds": {
                "maxItems": 0,
                "type": "array"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "lesson"
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "lessonIds": {
                "minItems": 1,
                "type": "array"
              },
              "nodeIds": {
                "maxItems": 0,
                "type": "array"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "node"
              }
            },
            "type": "object"
          },
          "then": {
            "properties": {
              "lessonIds": {
                "minItems": 1,
                "type": "array"
              },
              "nodeIds": {
                "minItems": 1,
                "type": "array"
              }
            }
          }
        }
      ]
    },
    "videoRef": {
      "description": "精确视频引用。KnownMap 不下载、代理或托管第三方视频，只保存引用。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "videoId",
        "partId"
      ],
      "properties": {
        "platform": {
          "description": "v1 只支持哔哩哔哩（D-V1-009）。",
          "enum": [
            "bilibili"
          ]
        },
        "videoId": {
          "type": "string",
          "pattern": "^BV[a-zA-Z0-9]{8,16}$"
        },
        "partId": {
          "description": "分 P 序号；单 P 视频为 null。显式可空而非省略，避免「缺失」与「无分 P」混淆。",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lessonId",
        "releaseLessonId",
        "order",
        "title",
        "videoRef",
        "nodes"
      ],
      "properties": {
        "lessonId": {
          "$ref": "#/$defs/stableId"
        },
        "releaseLessonId": {
          "description": "本次发布中该课节快照的身份。与 lessonId 分开：同一课节在不同发布中有不同快照（04 第 8 节）。",
          "$ref": "#/$defs/stableId"
        },
        "order": {
          "description": "课程内显式顺序，从 1 起。不依赖创建时间碰巧稳定（04 第 6 节）。",
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "$ref": "#/$defs/shortText"
        },
        "videoRef": {
          "$ref": "#/$defs/videoRef"
        },
        "nodes": {
          "description": "按 trigger.timeSeconds 升序、同时间按 nodeId 升序。允许为空：授权范围可能裁剪掉全部节点。",
          "type": "array",
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      }
    },
    "trigger": {
      "description": "v1 只有时间越过一种触发方式。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "timeSeconds"
      ],
      "properties": {
        "kind": {
          "const": "time_cross"
        },
        "timeSeconds": {
          "description": "视频内触发时刻，秒。允许小数以支持字幕句级定位。",
          "type": "number",
          "minimum": 0,
          "maximum": 86400
        }
      }
    },
    "node": {
      "description": "互动节点。v1 四类基线：重点内容（attention/notice）、选择题（practice/choice）、填空题（practice/blank）、问答题（followup/free_text）。类型专有字段由 oneOf 分支约束，未知组合安全拒绝。",
      "type": "object",
      "propertyNames": {
        "description": "封闭字段集。用 propertyNames 而非 additionalProperties：后者只看同一 schema 对象里的 properties，看不到 oneOf 分支，因此在这里无法封闭。设计 06 第 5.2 节禁止内部调试字段进入包。",
        "enum": [
          "nodeId",
          "enabled",
          "family",
          "interaction",
          "stateCompatibilityKey",
          "trigger",
          "effects",
          "display",
          "evaluation"
        ]
      },
      "required": [
        "nodeId",
        "enabled",
        "family",
        "interaction",
        "stateCompatibilityKey",
        "trigger",
        "effects",
        "display",
        "evaluation"
      ],
      "properties": {
        "nodeId": {
          "$ref": "#/$defs/stableId"
        },
        "enabled": {
          "type": "boolean"
        },
        "family": {
          "enum": [
            "attention",
            "practice",
            "followup"
          ]
        },
        "interaction": {
          "enum": [
            "notice",
            "choice",
            "blank",
            "free_text"
          ]
        },
        "stateCompatibilityKey": {
          "description": "完成语义的兼容标识（04 第 7.2 节）。完成规则改变时必须改变，使旧本机学习状态不被错误迁移。不能只凭 nodeId 判断可迁移。",
          "$ref": "#/$defs/stableId"
        },
        "trigger": {
          "$ref": "#/$defs/trigger"
        },
        "effects": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pause"
          ],
          "properties": {
            "pause": {
              "description": "第一阶段固定为 true：每个节点都暂停视频。",
              "const": true
            }
          }
        },
        "display": {
          "type": "object"
        },
        "evaluation": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "oneOf": [
        {
          "$ref": "#/$defs/noticeNode"
        },
        {
          "$ref": "#/$defs/choiceNode"
        },
        {
          "$ref": "#/$defs/blankNode"
        },
        {
          "$ref": "#/$defs/freeTextNode"
        }
      ]
    },
    "noticeNode": {
      "description": "重点内容：展示教师确认的信息，不要求作答。学生明确确认后完成。",
      "properties": {
        "family": {
          "const": "attention"
        },
        "interaction": {
          "const": "notice"
        },
        "display": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "body"
          ],
          "properties": {
            "title": {
              "$ref": "#/$defs/shortText"
            },
            "body": {
              "$ref": "#/$defs/longText"
            },
            "captionQuote": {
              "description": "可选字幕引用，仅供学生定位上下文。不携带完整字幕正文（DATA-CONTENT-003）。",
              "$ref": "#/$defs/longText"
            },
            "highlights": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "text"
                ],
                "properties": {
                  "text": {
                    "$ref": "#/$defs/shortText"
                  }
                }
              }
            }
          }
        },
        "evaluation": {
          "description": "重点内容没有判定，显式为 null 而非省略。",
          "type": "null"
        }
      },
      "type": "object"
    },
    "choiceNode": {
      "description": "选择题：按已发布正确选项确定性判断。",
      "properties": {
        "family": {
          "const": "practice"
        },
        "interaction": {
          "const": "choice"
        },
        "display": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "prompt",
            "options"
          ],
          "properties": {
            "title": {
              "$ref": "#/$defs/shortText"
            },
            "prompt": {
              "$ref": "#/$defs/longText"
            },
            "options": {
              "description": "至少两个可区分选项。optionId 在本节点内唯一。",
              "type": "array",
              "minItems": 2,
              "maxItems": 10,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "optionId",
                  "label"
                ],
                "properties": {
                  "optionId": {
                    "$ref": "#/$defs/stableId"
                  },
                  "label": {
                    "$ref": "#/$defs/shortText"
                  }
                }
              }
            }
          }
        },
        "evaluation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "correctOptionId"
          ],
          "properties": {
            "correctOptionId": {
              "description": "必须是 display.options 里某个 optionId。跨字段引用完整性由插件校验第 3 步保证，JSON Schema 无法表达。",
              "$ref": "#/$defs/stableId"
            },
            "explanation": {
              "$ref": "#/$defs/longText"
            }
          }
        }
      },
      "type": "object"
    },
    "blankNode": {
      "description": "填空题：按已发布规范化规则和可接受答案判断。",
      "properties": {
        "family": {
          "const": "practice"
        },
        "interaction": {
          "const": "blank"
        },
        "display": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "prompt"
          ],
          "properties": {
            "title": {
              "$ref": "#/$defs/shortText"
            },
            "prompt": {
              "$ref": "#/$defs/longText"
            }
          }
        },
        "evaluation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "acceptedAnswers",
            "normalize"
          ],
          "properties": {
            "acceptedAnswers": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/shortText"
              }
            },
            "normalize": {
              "description": "答案比较前的规范化步骤。顺序即应用顺序。",
              "type": "array",
              "maxItems": 2,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "trim",
                  "casefold"
                ]
              }
            },
            "explanation": {
              "$ref": "#/$defs/longText"
            }
          }
        }
      },
      "type": "object"
    },
    "freeTextNode": {
      "description": "问答题：接收学生自由表达，展示教师预设参考反馈。v1 不自动判定开放回答对错（FR-RUNTIME）。",
      "properties": {
        "family": {
          "const": "followup"
        },
        "interaction": {
          "const": "free_text"
        },
        "display": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "prompt"
          ],
          "properties": {
            "title": {
              "$ref": "#/$defs/shortText"
            },
            "prompt": {
              "$ref": "#/$defs/longText"
            }
          }
        },
        "evaluation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "referenceFeedback"
          ],
          "properties": {
            "referenceFeedback": {
              "description": "教师预先编写的参考反馈。提交非空回答并展示它后即完成，不产生自动正确结论。",
              "$ref": "#/$defs/longText"
            }
          }
        }
      },
      "type": "object"
    }
  }
}
