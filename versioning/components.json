{
  "schemaVersion": 1,
  "description": "KnownMap 组件版本来源、代码类别和审计规则。版本值尽量引用现有真源，不在这里复制运行时版本。",
  "components": {
    "product": {
      "label": "产品",
      "category": "product",
      "versionSource": { "type": "file", "path": "VERSION" }
    },
    "backend": {
      "label": "后端应用",
      "category": "application",
      "versionSource": { "type": "alias", "component": "product" }
    },
    "teacherWeb": {
      "label": "教师端",
      "category": "application",
      "versionSource": { "type": "alias", "component": "product" }
    },
    "adminWeb": {
      "label": "管理端",
      "category": "application",
      "versionSource": { "type": "alias", "component": "product" }
    },
    "studentExtension": {
      "label": "学生插件",
      "category": "integration",
      "versionSource": {
        "type": "regexFile",
        "path": "v1/extension/manifest/targets.ts",
        "pattern": "EXTENSION_VERSION\\s*=\\s*['\\\"]([^'\\\"]+)['\\\"]"
      }
    },
    "httpApi": {
      "label": "HTTP API 契约",
      "category": "contract",
      "versionSource": { "type": "jsonPointer", "path": "v1/contracts/versions.json", "pointer": ["contracts", "http_api", "version"] }
    },
    "coursePackage": {
      "label": "课程包契约",
      "category": "contract",
      "versionSource": { "type": "jsonPointer", "path": "v1/contracts/versions.json", "pointer": ["contracts", "course_package", "version"] }
    },
    "extensionMessages": {
      "label": "插件消息契约",
      "category": "contract",
      "versionSource": { "type": "jsonPointer", "path": "v1/contracts/versions.json", "pointer": ["contracts", "extension_messages", "version"] }
    },
    "extensionStorage": {
      "label": "插件存储契约",
      "category": "contract",
      "versionSource": { "type": "jsonPointer", "path": "v1/contracts/versions.json", "pointer": ["contracts", "extension_storage", "version"] }
    },
    "analyticsEvent": {
      "label": "分析事件契约",
      "category": "contract",
      "versionSource": { "type": "jsonPointer", "path": "v1/contracts/versions.json", "pointer": ["contracts", "analytics_event", "version"] }
    },
    "webBuild": {
      "label": "Web 构建组合",
      "category": "build",
      "versionSource": { "type": "jsonPointer", "path": "v1/contracts/versions.json", "pointer": ["builds", "web_build", "version"] }
    },
    "extensionBuild": {
      "label": "插件构建组合",
      "category": "build",
      "versionSource": { "type": "jsonPointer", "path": "v1/contracts/versions.json", "pointer": ["builds", "extension_build", "version"] }
    },
    "database": {
      "label": "数据库结构",
      "category": "architecture",
      "versionSource": { "type": "alembicHead", "path": "v1/backend/alembic/versions" }
    }
  },
  "auditProfiles": {
    "documentation": { "rank": 0, "label": "文档检查" },
    "governance": { "rank": 1, "label": "版本治理检查" },
    "page": { "rank": 1, "label": "页面/组件检查" },
    "backend-module": { "rank": 2, "label": "后端模块检查" },
    "extension": { "rank": 2, "label": "插件构建与关键路径检查" },
    "shared": { "rank": 3, "label": "共享模块及直接消费者检查" },
    "contract": { "rank": 4, "label": "契约兼容性检查" },
    "database": { "rank": 5, "label": "数据库迁移与恢复检查" },
    "production": { "rank": 5, "label": "生产发布与回滚检查" }
  },
  "rules": [
    { "id": "documentation", "category": "documentation", "auditProfile": "documentation", "versionRequired": false, "paths": ["README.md", "CHANGELOG.md", "changelog.md", "next.md", "doc/**", "docs/**"] },
    { "id": "governance", "category": "governance", "auditProfile": "governance", "versionRequired": false, "paths": ["VERSION", "versioning/**", "tools/version-check.mjs", "tests/version-check.test.js", "package.json"] },
    { "id": "database", "category": "architecture", "auditProfile": "database", "versionRequired": true, "components": ["database"], "paths": ["v1/backend/alembic/**"] },
    { "id": "backend-boundary", "category": "architecture", "auditProfile": "contract", "versionRequired": true, "components": ["backend"], "paths": ["v1/backend/app/api/**", "v1/backend/app/infrastructure/**", "v1/backend/app/config.py", "v1/backend/app/main.py", "v1/backend/app/modules/**/models.py", "v1/backend/app/modules/**/schemas.py", "v1/backend/app/modules/**/repository.py", "v1/backend/app/modules/**/routes.py"] },
    { "id": "version-manifest", "category": "governance", "auditProfile": "governance", "versionRequired": false, "paths": ["v1/contracts/versions.json"] },
    { "id": "shared-web", "category": "architecture", "auditProfile": "shared", "versionRequired": true, "components": ["teacherWeb", "adminWeb", "webBuild"], "paths": ["v1/web/shared/**"] },
    { "id": "contract-typed-view", "category": "governance", "auditProfile": "governance", "versionRequired": false, "paths": ["v1/contracts/version-manifest.ts"] },
    { "id": "contracts", "category": "architecture", "auditProfile": "contract", "versionRequired": true, "components": ["httpApi", "coursePackage", "extensionMessages", "extensionStorage", "analyticsEvent"], "paths": ["v1/contracts/**"] },
    { "id": "extension-boundary", "category": "architecture", "auditProfile": "contract", "versionRequired": true, "components": ["studentExtension", "extensionMessages", "extensionStorage"], "paths": ["v1/extension/manifest/**", "v1/extension/storage/**", "v1/extension/background/messages*", "v1/extension/background/service-worker.ts"] },
    { "id": "release", "category": "architecture", "auditProfile": "production", "versionRequired": false, "paths": ["tools/release.sh", "deploy/**", ".github/workflows/**", "package-lock.json", "v1/package-lock.json", "v1/backend/uv.lock"] },
    { "id": "extension", "category": "integration", "auditProfile": "extension", "versionRequired": true, "components": ["studentExtension", "extensionBuild"], "paths": ["v1/extension/**"] },
    { "id": "backend-application", "category": "application", "auditProfile": "backend-module", "versionRequired": true, "components": ["backend"], "paths": ["v1/backend/app/**"] },
    { "id": "teacher-application", "category": "application", "auditProfile": "page", "versionRequired": true, "components": ["teacherWeb"], "paths": ["v1/web/teacher/**"] },
    { "id": "admin-application", "category": "application", "auditProfile": "page", "versionRequired": true, "components": ["adminWeb"], "paths": ["v1/web/admin/**"] },
    { "id": "site-application", "category": "application", "auditProfile": "page", "versionRequired": true, "components": ["product"], "paths": ["v1/site/**"] },
    { "id": "tests", "category": "test", "auditProfile": "governance", "versionRequired": false, "paths": ["tests/**", "v1/**/test/**", "v1/**/*.test.*"] }
  ]
}
